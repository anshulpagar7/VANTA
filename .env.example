# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Keys are read in this order by `vanta build-cache`; the first that answers wins.

# https://aistudio.google.com/apikey  (free tier, no billing)
GEMINI_API_KEY=

# https://console.x.ai
XAI_API_KEY=

# https://platform.claude.com  (optional third fallback)
ANTHROPIC_API_KEY=

# https://github.com/marketplace/models  (optional fourth fallback)
GITHUB_TOKEN=
