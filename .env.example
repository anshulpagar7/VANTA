# Copy to .env and fill in ONE of these. .env is gitignored -- never commit real keys.
# A single-provider cache is preferable: mixing providers makes arm C an
# ensemble and weakens the C - B+ ablation.

# https://console.groq.com/keys        free tier, fast, OpenAI-compatible
GROQ_API_KEY=

# https://aistudio.google.com/apikey   free tier, quota-limited per model
GEMINI_API_KEY=

# https://openrouter.ai/keys           models suffixed ":free" cost nothing
OPENROUTER_API_KEY=

# https://github.com/marketplace/models   free with a GitHub account
GITHUB_TOKEN=

# https://console.x.ai                 paid
XAI_API_KEY=

# https://platform.claude.com          paid, ~$0.10 for a full cache build
ANTHROPIC_API_KEY=
